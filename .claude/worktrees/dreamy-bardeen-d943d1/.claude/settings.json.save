    "ask": [
      "Write(*)",
      "Edit(*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(npm:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(rm:*)",
      "Bash(sudo:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Read(~/.ssh/**)",
      "Read(~/.env)",
      "Read(/etc/**)"
    ]
